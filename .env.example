DATABASE_URL=postgresql://paastech:paastech@localhost:5433/paastech
HOST=127.0.0.1
PORT=8080

POSTGRES_USER=paastech
POSTGRES_PASSWORD=paastech
POSTGRES_DB=paastech

# Docker socket path (leave empty for default socket detection)
# Rootless Docker: DOCKER_HOST=unix:///run/user/1000/docker.sock
DOCKER_HOST=

# Buildpack builder image to use for `pack build`
BUILDER=gcr.io/buildpacks/builder:google-22

# Traefik routing
BASE_DOMAIN=localhost
DOCKER_SOCK=/var/run/docker.sock

# Production only (compose.prod.yml)
# PAASTECH_IMAGE=registry.gitlab.com/<group>/<project>:latest
# ACME_EMAIL=your@email.com
# CF_DNS_API_TOKEN=your_cloudflare_api_token
